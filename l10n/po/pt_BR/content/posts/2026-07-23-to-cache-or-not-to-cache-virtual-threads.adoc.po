msgstr ""

msgid "4 GB TPS"
msgstr ""

msgid "4 GB Full GCs"
msgstr ""

msgid "1 GB TPS"
msgstr ""

msgid "1 GB Full GCs"
msgstr ""

msgid "*no pooling*"
msgstr ""

msgid "126,851"
msgstr ""

msgid "0"
msgstr ""

