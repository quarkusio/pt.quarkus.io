#. mt: deepl
#, fuzzy
msgid "What&#8217;s new"
msgstr "Novidades"

#, fuzzy
msgid "It is our pleasure to announce the availability of Quarkus 3.0.0.CR1."
msgstr "Temos o prazer de anunciar a disponibilidade do Quarkus 3.0.0.CR1."

#, fuzzy
msgid ""
"We are working full steam on polishing Quarkus 3.0 so please try it with your applications\n"
"and report any problem to us by https://github.com/quarkusio/quarkus/issues[creating a GitHub issue]."
msgstr "Estamos trabalhando a todo vapor no aprimoramento do Quarkus 3.0, portanto, experimente-o com seus aplicativos e relate qualquer problema link:https://github.com/quarkusio/quarkus/issues[criando um problema no GitHub] ."

#, fuzzy
msgid "To upgrade your application to Quarkus 3.0, see <<upgrading,the instructions below>>."
msgstr "Para atualizar a sua aplicação para o Quarkus 3.0, consulte  link:#upgrading[as instruções abaixo]."

#, fuzzy
msgid "Among a lot of bugfixes and small enhancements, the highlights of this release are:"
msgstr "Entre uma série de correcções de erros e pequenas melhorias, os destaques desta versão são:"

#, fuzzy
msgid "The introduction of the `/q/info` endpoint exposing information about your application"
msgstr "A introdução do ponto de extremidade `/q/info` que expõe informações sobre a sua aplicação"

#, fuzzy
msgid "A `quarkus update` command based on our OpenRewrite upgrade recipes"
msgstr "Um comando `quarkus update` baseado nas nossas receitas de atualização do OpenRewrite"

#, fuzzy
msgid "A new Redis backend for the Cache extension"
msgstr "Um novo backend Redis para a extensão Cache"

#, fuzzy
msgid "The support for Maven 3.9"
msgstr "O suporte para Maven 3.9"

#, fuzzy
msgid "CLI plugins"
msgstr "Plugins CLI"

#, fuzzy
msgid "Support for multiple mailers"
msgstr "Suporte para vários mailers"

#, fuzzy
msgid "/q/info"
msgstr "/q/info"

#, fuzzy
msgid "To expose information about your application (such as the git hash), add the `quarkus-info` extension to your project."
msgstr "Para expor informações sobre a sua aplicação (como o hash do git), adicione a extensão `quarkus-info` ao seu projeto."

#, fuzzy
msgid "The endpoint is available on `/q/info` and will be exposed on the management network interface if you enable it."
msgstr "O ponto final está disponível em `/q/info` e será exposto na interface de rede de gestão se o ativar."

msgid "quarkus update"
msgstr "quarkus update"

#, fuzzy
msgid ""
"Until now, the migration of your project had to be done via a JBang script\n"
"but the update is now embedded in the Quarkus tooling (using the same OpenRewrite recipes)."
msgstr "Até agora, a migração do seu projeto tinha que ser feita por meio de um script JBang, mas agora a atualização está incorporada nas ferramentas do Quarkus (usando as mesmas receitas do OpenRewrite)."

#, fuzzy
msgid "See the <<automated-migration>> section below for more information."
msgstr "Consulte a secção  link:#automated-migration[[automated-migration]] abaixo para obter mais informações."

#, fuzzy
msgid "Redis backend for Cache extension"
msgstr "Backend Redis para a extensão Cache"

#, fuzzy
msgid "It is now possible to use a Redis backend with the Cache extension."
msgstr "Agora é possível utilizar um backend Redis com a extensão Cache."

#, fuzzy
msgid "More information in the https://quarkus.io/version/main/guides/cache-redis-reference[dedicated guide]."
msgstr "Mais informações no  link:https://quarkus.io/version/main/guides/cache-redis-reference[guia específico]."

#, fuzzy
msgid "Support for Maven 3.9"
msgstr "Suporte para Maven 3.9"

#, fuzzy
msgid ""
"Maven 3.9 came with some breaking changes and the integration with Quarkus was not working properly.\n"
"It is now fixed and you can use Maven 3.9 to build your Quarkus 3.0.0.CR1 applications."
msgstr "O Maven 3.9 veio com algumas mudanças significativas e a integração com o Quarkus não estava funcionando corretamente. Agora isso foi corrigido e o senhor pode usar o Maven 3.9 para criar seus aplicativos Quarkus 3.0.0.CR1."

#, fuzzy
msgid ""
"The Quarkus CLI was made extensible with plugins.\n"
"Expect a lot of new features in the Quarkus CLI in the form of plugins in the near future."
msgstr "A CLI do Quarkus foi ampliada com plug-ins. O senhor pode esperar muitos recursos novos na CLI do Quarkus na forma de plug-ins em um futuro próximo."

#, fuzzy
msgid "Multiple mailers"
msgstr "Vários mailers"

#, fuzzy
msgid "Sending emails via several SMTP servers is supported in Quarkus 3.0.0.CR1."
msgstr "O envio de mensagens de correio eletrónico através de vários servidores SMTP é suportado no Quarkus 3.0.0.CR1."

#, fuzzy
msgid "Have a look at the https://quarkus.io/version/main/guides/mailer-reference#multiple-mailer-configurations[updated documentation]."
msgstr "Consulte a  link:https://quarkus.io/version/main/guides/mailer-reference#multiple-mailer-configurations[documentação actualizada]."

