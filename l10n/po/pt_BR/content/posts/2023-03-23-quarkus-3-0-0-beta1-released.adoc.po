#. mt: deepl
#, fuzzy
msgid "What&#8217;s new"
msgstr "Novidades"

#, fuzzy
msgid "It is our pleasure to announce the availability of Quarkus 3.0.0.Beta1."
msgstr "Temos o prazer de anunciar a disponibilidade do Quarkus 3.0.0.Beta1."

#, fuzzy
msgid ""
"We plan to release Quarkus 3.0.0.CR1 next week so now is a good time for testing the migration of your applications to Quarkus 3\n"
"(see <<upgrading,below>> for more information about upgrading)."
msgstr "Planejamos lançar o Quarkus 3.0.0.CR1 na próxima semana, portanto, agora é um bom momento para testar a migração dos seus aplicativos para o Quarkus 3 (veja xref:upgrading[abaixo] mais informações sobre a atualização)."

#, fuzzy
msgid "Among a lot of bugfixes and small enhancements, the highlights of this release are:"
msgstr "Entre uma série de correcções de erros e pequenas melhorias, os destaques desta versão são:"

#, fuzzy
msgid "Hibernate Reactive and Camel Quarkus are back!"
msgstr "O Hibernate Reactive e o Camel Quarkus estão de volta!"

#, fuzzy
msgid "Technical endpoints can be exposed on a specific management network interface"
msgstr "Os pontos finais técnicos podem ser expostos numa interface de rede de gestão específica"

#, fuzzy
msgid "Support for SDK autoconfiguration in OpenTelemetry extension"
msgstr "Suporte para autoconfiguração do SDK na extensão OpenTelemetry"

#, fuzzy
msgid "Hibernate Reactive"
msgstr "Hibernar Reativo"

#, fuzzy
msgid ""
"Hibernate Reactive has been reintroduced into Quarkus.\n"
"Hibernate Reactive 2.0 is in Alpha and is based on Hibernate ORM 6.2."
msgstr "O Hibernate Reactive foi reintroduzido no Quarkus. O Hibernate Reactive 2.0 está em Alpha e é baseado no Hibernate ORM 6.2."

#, fuzzy
msgid "Camel Quarkus"
msgstr "Camelo Quarkus"

#, fuzzy
msgid ""
"Camel Quarkus is back in the Quarkus Platform,\n"
"with a new major version compatible with Jakarta EE 10 and Quarkus 3."
msgstr "O Camel Quarkus está de volta à plataforma Quarkus, com uma nova versão principal compatível com o Jakarta EE 10 e o Quarkus 3."

#, fuzzy
msgid ""
"Note that, while Quarkus 3 is still compatible with Java 11,\n"
"the Camel Quarkus extensions require Java 17."
msgstr "Observe que, embora o Quarkus 3 ainda seja compatível com o Java 11, as extensões do Camel Quarkus exigem o Java 17."

#, fuzzy
msgid "Management network interface"
msgstr "Interface de rede de gestão"

#, fuzzy
msgid "Until now, all the Quarkus endpoints were exposed on the same network interface."
msgstr "Até agora, todos os terminais Quarkus estavam expostos na mesma interface de rede."

#, fuzzy
msgid "It is now possible to expose technical endpoints such as the health and metrics ones on a different interface thanks to https://quarkus.io/version/main/guides/management-interface-reference[a specific management interface]."
msgstr "É agora possível expor pontos de extremidade técnicos, como os de saúde e métricos, numa interface diferente, graças a  link:https://quarkus.io/version/main/guides/management-interface-reference[uma interface de gestão específica]."

#, fuzzy
msgid "OpenTelemetry"
msgstr "OpenTelemetry"

#, fuzzy
msgid "The OpenTelemetry extension has been rewritten to support the SDK autoconfiguration."
msgstr "A extensão OpenTelemetry foi reescrita para suportar a autoconfiguração do SDK."

#, fuzzy
msgid "Trying out Quarkus 3"
msgstr "Experimentar o Quarkus 3"

#, fuzzy
msgid "For now the easiest way to get started is using https://code.quarkus.io/?S=io.quarkus.platform%3A3.0[code.quarkus.io] or use the Quarkus CLI:"
msgstr "Por enquanto, a maneira mais fácil de começar é usar  link:https://code.quarkus.io/?S=io.quarkus.platform%3A3.0[code.quarkus.io] ou usar o Quarkus CLI:"

#, fuzzy
msgid ""
"Mind you that at this stage, while all the core extensions are available, only parts of the Quarkus platform is present.\n"
"Not all extensions have yet migrated to Jakarta packages."
msgstr "Lembre-se de que, nesta etapa, embora todas as principais extensões estejam disponíveis, apenas partes da plataforma Quarkus estão presentes. Nem todas as extensões ainda migraram para os pacotes Jakarta."

