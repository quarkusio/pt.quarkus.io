msgid "Author template fields"
msgstr "Campos do modelo de autor"

#, fuzzy
msgid "Field"
msgstr "Campo"

msgid "Type"
msgstr "Tipo"

msgid "Description"
msgstr "Descrição"

#, fuzzy
msgid "`artifact`"
msgstr "`artefato`"

msgid "string"
msgstr "string"

#, fuzzy
msgid "Extension runtime artifact coordinates. In the author template this may use Maven expressions such as ${project.groupId}:${project.artifactId}:${project.version}; the build replaces them with resolved coordinates. This field may be omitted from the template."
msgstr "Coordenadas do artefato de tempo de execução da extensão. No modelo do autor, isso pode utilizar expressões do Maven, como ${project.groupId}:${project.artifactId}:${project.version}; a compilação as substitui pelas coordenadas resolvidas. Este campo pode ser omitido do modelo."

#, fuzzy
msgid "`description`"
msgstr "`descrição`"

#, fuzzy
msgid "Description displayed to users. It may be provided in the template or copied from the extension module POM during the build."
msgstr "Descrição exibida aos usuários. Ela pode ser fornecida no modelo ou copiada do POM do módulo de extensão durante a compilação."

