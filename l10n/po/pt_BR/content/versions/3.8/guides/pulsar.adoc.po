msgid "Maximum duration for completing a request."
msgstr "Duração máxima para concluir uma solicitação."

msgid "*readTimeoutMs*"
msgstr ""

msgid "Maximum read time of a request."
msgstr "Tempo máximo de leitura de uma solicitação."

msgid "*autoCertRefreshSeconds*"
msgstr ""

msgid "Seconds of auto refreshing certificate."
msgstr "Segundos de atualização automática do certificado."

msgid "300"
msgstr ""

msgid "*initialBackoffIntervalNanos*"
msgstr ""

msgid "Initial backoff interval (in nanosecond)."
msgstr "Intervalo de recuo inicial (em nanossegundos)."

msgid "100000000"
msgstr ""

msgid "*maxBackoffIntervalNanos*"
msgstr ""

msgid "Max backoff interval (in nanosecond)."
msgstr "Intervalo máximo de recuo (em nanossegundos)."

msgid "60000000000"
msgstr ""

msgid "*enableBusyWait*"
msgstr ""

msgid "Whether to enable BusyWait for EpollEventLoopGroup."
msgstr "Se deseja habilitar BusyWait para EpollEventLoopGroup."

msgid "*listenerName*"
msgstr ""

msgid "Listener name for lookup. Clients can use listenerName to choose one of the listeners as the service URL to create a connection to the broker as long as the network is accessible.\"advertisedListeners\" must enabled in broker side."
msgstr "Nome do ouvinte para pesquisa. Os clientes podem usar listenerName para escolher um dos ouvintes como a URL do serviço para criar uma conexão com o broker, desde que a rede esteja acessível.\" advertisedListeners\" deve ser habilitado no lado do corretor."

msgid "*useKeyStoreTls*"
msgstr ""

msgid "Set TLS using KeyStore way."
msgstr "Defina o TLS usando o modo KeyStore."

msgid "*sslProvider*"
msgstr ""

msgid "The TLS provider used by an internal client to authenticate with other Pulsar brokers."
msgstr "O provedor TLS usado por um cliente interno para autenticar com outros brokers Pulsar."

msgid "*tlsKeyStoreType*"
msgstr ""

msgid "TLS KeyStore type configuration."
msgstr "Configuração do tipo TLS KeyStore."

msgid "JKS"
msgstr ""

msgid "*tlsKeyStorePath*"
msgstr ""

msgid "Path of TLS KeyStore."
msgstr "Caminho do TLS KeyStore."

msgid "*tlsKeyStorePassword*"
msgstr ""

msgid "Password of TLS KeyStore."
msgstr "Senha do TLS KeyStore."

msgid "*tlsTrustStoreType*"
msgstr ""

msgid "TLS TrustStore type configuration. You need to set this configuration when client authentication is required."
msgstr "Configuração do tipo TLS TrustStore. Você precisa definir essa configuração quando a autenticação do cliente é necessária."

msgid "*tlsTrustStorePath*"
msgstr ""

msgid "Path of TLS TrustStore."
msgstr "Caminho do TLS TrustStore."

msgid "*tlsTrustStorePassword*"
msgstr ""

msgid "Password of TLS TrustStore."
msgstr "Senha do TLS TrustStore."

msgid "*tlsCiphers*"
msgstr ""

msgid "Set of TLS Ciphers."
msgstr "Conjunto de cifras TLS."

msgid "*tlsProtocols*"
msgstr ""

msgid "Protocols of TLS."
msgstr "Protocolos de TLS."

msgid "*memoryLimitBytes*"
msgstr ""

msgid "Limit of client memory usage (in byte). The 64M default can guarantee a high producer throughput."
msgstr "Limite de uso de memória do cliente (em byte). O padrão de 64 milhões pode garantir uma alta taxa de transferência do produtor."

msgid "67108864"
msgstr ""

msgid "*proxyServiceUrl*"
msgstr ""

msgid "URL of proxy service. proxyServiceUrl and proxyProtocol must be mutually inclusive."
msgstr "URL do serviço de proxy. proxyServiceUrl e proxyProtocol devem ser mutuamente inclusivos."

msgid "*proxyProtocol*"
msgstr ""

msgid "Protocol of proxy service. proxyServiceUrl and proxyProtocol must be mutually inclusive."
msgstr "Protocolo do serviço de proxy. proxyServiceUrl e proxyProtocol devem ser mutuamente inclusivos."

msgid "ProxyProtocol"
msgstr ""

msgid "*enableTransaction*"
msgstr ""

msgid "Whether to enable transaction."
msgstr "Se deve habilitar a transação."

msgid "*clock*"
msgstr ""

msgid "Clock"
msgstr "Relógio"

msgid "*dnsLookupBindAddress*"
msgstr ""

msgid "The Pulsar client dns lookup bind address, default behavior is bind on 0.0.0.0"
msgstr "O endereço de ligação de pesquisa dns do cliente Pulsar, o comportamento padrão é vincular em 0.0.0.0"

msgid "*dnsLookupBindPort*"
msgstr ""

msgid "The Pulsar client dns lookup bind port, takes effect when dnsLookupBindAddress is configured, default value is 0."
msgstr "A porta de ligação de pesquisa dns do cliente Pulsar, entra em vigor quando dnsLookupBindAddress é configurado, o valor padrão é 0."

msgid "*socks5ProxyAddress*"
msgstr ""

msgid "Address of SOCKS5 proxy."
msgstr "Endereço do proxy SOCKS5."

msgid "InetSocketAddress"
msgstr ""

msgid "*socks5ProxyUsername*"
msgstr ""

msgid "User name of SOCKS5 proxy."
msgstr "Nome de usuário do proxy SOCKS5."

msgid "*socks5ProxyPassword*"
msgstr ""

msgid "Password of SOCKS5 proxy."
msgstr "Senha do proxy SOCKS5."

msgid "*description*"
msgstr ""

msgid "The extra description of the client version. The length cannot exceed 64."
msgstr "A descrição extra da versão do cliente. O comprimento não pode exceder 64."

