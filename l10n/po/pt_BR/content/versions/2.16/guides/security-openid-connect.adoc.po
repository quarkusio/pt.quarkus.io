msgid "[[quarkus-oidc_quarkus.oidc.-tenant-.authentication.response-mode]]`link:#quarkus-oidc_quarkus.oidc.-tenant-.authentication.response-mode[quarkus.oidc.\"tenant\".authentication.response-mode]`"
