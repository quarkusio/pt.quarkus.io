msgstr ""

msgid "You need a stable, battle-tested transport"
msgstr ""

msgid "Your application primarily handles network I/O"
msgstr ""

msgid "You are running on an older kernel (pre-5.1)"
msgstr ""

msgid "You need the widest compatibility"
msgstr ""

msgid "Use io_uring if"
msgstr ""

msgid "You have a mixed workload with file and network I/O"
