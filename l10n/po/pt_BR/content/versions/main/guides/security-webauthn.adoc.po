msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_WEBAUTHN_NEW_COOKIE_INTERVAL+++[]"
msgstr "Variável de ambiente: env_var_with_copy_button:QUARKUS_WEBAUTHN_NEW_COOKIE_INTERVAL[]"

