msgid ""
"[[quarkus-hibernate-search-orm-elasticsearch_quarkus-hibernate-search-orm-indexing-plan-synchronization-strategy]] [.property-path]##link:#quarkus-hibernate-search-orm-elasticsearch_quarkus-hibernate-search-orm-indexing-plan-synchronization-strategy[`+++quarkus.hibernate-search-orm.indexing.plan.synchronization.strategy+++`]##\n"
