msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_HTTP_CORS_RETURN_EXACT_ORIGINS+++[]"
msgstr "Variável de ambiente: env_var_with_copy_button:QUARKUS_HTTP_CORS_RETURN_EXACT_ORIGINS[]"

