"icon:lock[title=Fixed at build time] [[quarkus-kubernetes-client_quarkus-kubernetes-client-devservices_quarkus-kubernetes-client-devservices-shared]] [.property-path]##link:#quarkus-kubernetes-client_quarkus-kubernetes-client-devservices_quarkus-kubernetes-client-devservices-shared[`quarkus.kubernetes-client.devservices.shared`]##\n"
