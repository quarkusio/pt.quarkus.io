"[[quarkus-mailer_quarkus-mailer-mailer-name-truststore-password]]`link:#quarkus-mailer_quarkus-mailer-mailer-name-truststore-password[quarkus.mailer.\"mailer-name\".truststore.password]`\n"
"\n"
"\n"
"[.description]\n"
"--\n"
"Sets the trust store password if any. Note that the password is only used for JKS and PCK++#++12 trust stores.\n"
"\n"
"Environment variable: env_var_with_copy_button:+++QUARKUS_MAILER__MAILER_NAME__TRUSTSTORE_PASSWORD+++[]\n"
"--"
msgstr ""

msgid "[[quarkus-mailer_quarkus-mailer-mailer-name-truststore-password]]`link:#quarkus-mailer_quarkus-mailer-mailer-name-truststore-password[quarkus.mailer.\"mailer-name\".truststore.password]`"
