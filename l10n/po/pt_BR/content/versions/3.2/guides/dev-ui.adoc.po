msgstr ""

msgid "Linking to your full-page templates"
msgstr ""

msgid ""
"Full-page templates for extensions live under a pre-defined `{devRootAppend}/"
"{groupId}.{artifactId}/` directory\n"
"that is referenced using the `urlbase` template parameter. Using "
"configuration defaults, that would resolve to\n"
"`/q/dev-v1/io.quarkus.quarkus-cache/`, as an example."
msgstr ""

