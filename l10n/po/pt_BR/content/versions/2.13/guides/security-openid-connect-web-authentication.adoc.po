"[[quarkus-oidc_quarkus.oidc.-tenant-.authentication.cookie-domain]]`link:#quarkus-oidc_quarkus.oidc.-tenant-.authentication.cookie-domain[quarkus.oidc.\"tenant\".authentication.cookie-domain]`\n"
"\n"
"[.description]\n"
"--\n"
"Cookie domain parameter value which, if set, will be used for the session, state and post logout cookies.\n"
"\n"
"Environment variable: env_var_with_copy_button:+++QUARKUS_OIDC__TENANT__AUTHENTICATION_COOKIE_DOMAIN+++[]\n"
"--"
msgstr ""

msgid "[[quarkus-oidc_quarkus.oidc.-tenant-.authentication.cookie-domain]]`link:#quarkus-oidc_quarkus.oidc.-tenant-.authentication.cookie-domain[quarkus.oidc.\"tenant\".authentication.cookie-domain]`"
