msgid ""
"[[quarkus-oidc_quarkus.oidc.-tenant-.token.refresh-expired]]`link:#quarkus-"
"oidc_quarkus.oidc.-tenant-.token.refresh-expired[quarkus.oidc.\"tenant\"."
"token.refresh-expired]`\n"
"\n"
"[.description]\n"
"--\n"
"Refresh expired ID tokens. If this property is enabled then a refresh token "
"request will be performed if the ID token has expired and, if successful, "
"the local session will be updated with the new set of tokens. Otherwise, the "
"local session will be invalidated and the user redirected to the OpenID "
"Provider to re-authenticate. In this case the user may not be challenged "
"again if the OIDC provider session is still active. For this option be "
"effective the `authentication.session-age-extension` property should also be "
"set to a non-zero value since the refresh token is currently kept in the "
"user session. This option is valid only when the application is of type "
"`ApplicationType++#++WEB_APP`++}++.\n"
"\n"
"Environment variable: env_var_with_copy_button:"
"+++QUARKUS_OIDC__TENANT__TOKEN_REFRESH_EXPIRED+++[]\n"
"--"
msgstr ""

msgid ""
"[[quarkus-oidc_quarkus.oidc.-tenant-.token.refresh-expired]]`link:#quarkus-"
"oidc_quarkus.oidc.-tenant-.token.refresh-expired[quarkus.oidc.\"tenant\"."
"token.refresh-expired]`"
msgstr ""

msgid ""
"Environment variable: env_var_with_copy_button:"
"+++QUARKUS_OIDC__TENANT__TOKEN_REFRESH_EXPIRED+++[]"
msgstr ""

msgid ""
"[[quarkus-oidc_quarkus.oidc.-tenant-.token.refresh-token-time-skew]]`link:"
"#quarkus-oidc_quarkus.oidc.-tenant-.token.refresh-token-time-skew[quarkus."
"oidc.\"tenant\".token.refresh-token-time-skew]`\n"
"\n"
"[.description]\n"
"--\n"
"Refresh token time skew in seconds. If this property is enabled then the "
"configured number of seconds is added to the current time when checking "
"whether the access token should be refreshed. If the sum is greater than "
"this access token's expiration time then a refresh is going to happen. This "
"property will be ignored if the 'refresh-expired' property is not enabled.\n"
"\n"
"Environment variable: env_var_with_copy_button:"
"+++QUARKUS_OIDC__TENANT__TOKEN_REFRESH_TOKEN_TIME_SKEW+++[]\n"
"--"
msgstr ""

msgid ""
"[[quarkus-oidc_quarkus.oidc.-tenant-.token.refresh-token-time-skew]]`link:"
