#, fuzzy
msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_LRA_DEVSERVICES_SHARED+++[]"
msgstr "Variável de ambiente: env_var_with_copy_button:QUARKUS_LRA_DEVSERVICES_SHARED[]"

