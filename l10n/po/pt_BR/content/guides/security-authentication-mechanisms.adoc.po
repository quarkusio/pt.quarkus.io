msgstr ""

msgid "1000"
msgstr "1000"

msgid "Mutual TLS authentication mechanism"
msgstr ""

msgid "`quarkus.http.auth.mtls.priority`"
msgstr ""

msgid "1000 by default, 3000 when an inclusive authentication is enabled"
msgstr ""

