#. type: Hash Value: jobs check steps name
#: .github/workflows/check-yaml-po4a.yml:1
#, no-wrap
msgid "Install po4a"
msgstr ""

#. type: Hash Value: jobs check steps run
#: .github/workflows/check-yaml-po4a.yml:1
#, no-wrap
msgid ""
"sudo apt-get install -y -qq --no-install-recommends po4a \\\n"
"  || { sudo apt-get update -qq && sudo apt-get install -y -qq --no-install-recommends po4a; }\n"
"dpkg-query -W -f='po4a ${Version}\\n' po4a\n"
msgstr ""

#. type: Hash Value: jobs check steps name
#: .github/workflows/check-yaml-po4a.yml:1
#, no-wrap
msgid "Check content YAML files"
msgstr ""

#. type: Hash Value: jobs check steps run
#: .github/workflows/check-yaml-po4a.yml:1
#, no-wrap
msgid ""
"failed=0\n"
"while IFS= read -r file; do\n"
"  if ! output=$(po4a-updatepo --no-deprecation --msgmerge-opt --no-fuzzy-matching \\\n"
"      --master-charset UTF-8 -f yaml --master \"$file\" --po \"$RUNNER_TEMP/check.po\" 2>&1); then\n"
"    echo \"::error file=$file::po4a cannot parse this file, so pt.quarkus.io cannot translate it. See the job log for the reason.\"\n"
"    echo \"$output\"\n"
"    failed=1\n"
"  fi\n"
"  rm -f \"$RUNNER_TEMP/check.po\"\n"
"done < <(git ls-files -- '*.yml' '*.yaml' \\\n"
"  ':(exclude).github/' ':(exclude)theme/' ':(exclude)_data/publications.yaml')\n"
"exit $failed\n"
msgstr ""

