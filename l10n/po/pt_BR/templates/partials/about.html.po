#. type: Content of: <div><div><div><div><div><h3>
#: templates/partials/about.html:10
msgid "Developer Joy"
msgstr ""

#. type: Content of: <div><div><div><div><div><p>
#: templates/partials/about.html:11
msgid "Developers are critical to the success of almost every organization and they need the tools to build cloud-native applications quickly and efficiently. Quarkus provides a frictionless development experience through a combination of tools, libraries, extensions, and more. Quarkus makes developers more efficient with tools to improve the inner loop development cycle while in dev mode."
msgstr ""

#. type: Content of: <div><div><div><div><div><p>
#: templates/partials/about.html:11
msgid "<i class=\"fa fa-chevron-right\"></i><a href=\"/developer-joy/\">Learn more about Developer Joy</a>"
msgstr ""

#. type: Content of: <div><div><div><div><div><h3>
#: templates/partials/about.html:20
msgid "Kubernetes-native"
msgstr ""

#. type: Content of: <div><div><div><div><div><p>
#: templates/partials/about.html:21
msgid "Quarkus was built from the ground up for Kubernetes making it easy to deploy applications without having to understand all of the complexities of the platform. Quarkus allows developers to automatically generate Kubernetes resources including building and deploying container images without having to manually create YAML files."
msgstr ""

#. type: Content of: <div><div><div><div><div><p>
#: templates/partials/about.html:22
msgid "<i class=\"fa fa-chevron-right\"></i><a href=\"/kubernetes-native/\">Learn more about Kubernetes-native</a>"
msgstr ""

#. type: Content of: <div><div><div><div><div><h3>
#: templates/partials/about.html:31
msgid "Best of Breed Libraries and Standards"
msgstr ""

#. type: Content of: <div><div><div><div><div><p>
#: templates/partials/about.html:32
msgid "Quarkus provides a cohesive, fun to use, full-stack framework by leveraging a growing list of hundreds of best-of-breed libraries that you love and use. All wired on a standard backbone."
msgstr ""

#. type: Content of: <div><div><div><div><div><p>
#: templates/partials/about.html:33
msgid "<i class=\"fa fa-chevron-right\"></i><a href=\"/standards/\">Learn more about Standards</a>"
msgstr ""

#. type: Content of: <div><div><div><div><div><h3>
#: templates/partials/about.html:42
msgid "Imperative and reactive code"
msgstr ""

#. type: Content of: <div><div><div><div><div><p>
#: templates/partials/about.html:43
msgid "Quarkus is designed to seamlessly combine the familiar imperative style code and the non-blocking, reactive style when developing applications."
msgstr ""

#. type: Content of: <div><div><div><div><div><p>
#: templates/partials/about.html:44
msgid "This is helpful for both Java developers who are used to working with the imperative model and don’t want to switch things up, and those working with a cloud-native/reactive approach. The Quarkus development model can adapt itself to whatever app you’re developing."
msgstr ""

#. type: Content of: <div><div><div><div><div><p>
#: templates/partials/about.html:45
msgid "<i class=\"fa fa-chevron-right\"></i><a href=\"/continuum/\">Learn more about Reactive</a>"
msgstr ""

