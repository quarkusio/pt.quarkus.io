#. type: Title ===
#. mt: deepl
#: _versions/main/guides/native-transport-reference.adoc
#, fuzzy
msgid "SO_REUSEPORT"
msgstr "SO_REUSEPORT"

#. type: Plain text
#. mt: deepl
#: _versions/main/guides/native-transport-reference.adoc
#, fuzzy
msgid ""
"Allows multiple sockets to bind to the same address and port.\n"
"The kernel distributes incoming connections across the sockets, improving scalability."
msgstr "Permite que vários soquetes se liguem ao mesmo endereço e porta. O kernel distribui as conexões recebidas entre os soquetes, melhorando a escalabilidade."

#. type: Title ===
#. mt: deepl
#: _versions/main/guides/native-transport-reference.adoc
#, fuzzy
msgid "TCP_QUICKACK"
msgstr "TCP_QUICKACK"

#. type: Plain text
#. mt: deepl
#: _versions/main/guides/native-transport-reference.adoc
#, fuzzy
msgid "Disables delayed ACKs, reducing latency for request-response protocols."
msgstr "Desativa os ACKs atrasados, reduzindo a latência em protocolos de solicitação-resposta."

#. type: Title ===
#. mt: deepl
#: _versions/main/guides/native-transport-reference.adoc
#, fuzzy
msgid "TCP_CORK"
msgstr "TCP_CORK"

#. type: Plain text
#. mt: deepl
#: _versions/main/guides/native-transport-reference.adoc
#, fuzzy
msgid "Buffers small packets until the buffer is full or the cork is removed, reducing the number of packets sent."
msgstr "Armazena pacotes pequenos no buffer até que este fique cheio ou até que o bloqueio seja removido, reduzindo assim o número de pacotes enviados."

#. type: Title ===
#. mt: deepl
#: _versions/main/guides/native-transport-reference.adoc
#, fuzzy
msgid "TCP_FASTOPEN"
msgstr "TCP_FASTOPEN"

#. type: Plain text
#. mt: deepl
#: _versions/main/guides/native-transport-reference.adoc
#, fuzzy
msgid "Enables TCP Fast Open, allowing data to be sent in the SYN packet during connection establishment."
msgstr "Ativa o TCP Fast Open, permitindo que os dados sejam enviados no pacote SYN durante o estabelecimento da conexão."

#. type: Title ===
#. mt: deepl
#: _versions/main/guides/native-transport-reference.adoc
#, fuzzy
msgid "TCP_USER_TIMEOUT"
msgstr "TCP_USER_TIMEOUT"

#. type: Plain text
#. mt: deepl
#: _versions/main/guides/native-transport-reference.adoc
